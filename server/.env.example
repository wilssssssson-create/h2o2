# 本地默认 SQLite。公开部署改为 PostgreSQL，例如：
# H2O2_DATABASE_URL=postgresql+psycopg://h2o2:password@localhost:5432/h2o2
H2O2_DATABASE_URL=sqlite:///./data/h2o2.db
H2O2_INVITE_CODE=h2o2-class
H2O2_COOKIE_SECURE=false
H2O2_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
H2O2_ALLOW_LAN_ORIGINS=true
